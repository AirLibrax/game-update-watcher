{
  "manifest_version": 2,
  "id": "github.airlibrax.game-update-watcher",
  "version": "0.3.0",
  "name": "游戏更新速报",
  "description": "定时采集多款游戏版本更新信息（鸣潮/明日方舟/终末地/绝区零/崩铁），字段级交叉认证后按 6 周版本节奏生成汇总图，推送到指定 QQ 群。新增游戏只需写一个 JSON 配置。",
  "author": {
    "name": "AirLibrax",
    "url": "https://github.com/AirLibrax"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/AirLibrax/game-update-watcher",
    "homepage": "https://github.com/AirLibrax/game-update-watcher",
    "documentation": "https://github.com/AirLibrax/game-update-watcher/blob/main/README.md",
    "issues": "https://github.com/AirLibrax/game-update-watcher/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "9.99.99"
  },
  "sdk": {
    "min_version": "2.6.0",
    "max_version": "9.99.99"
  },
  "dependencies": [],
  "plugin_type": "integration",
  "capabilities": ["send.image", "chat.open_session"],
  "display": {
    "icon": {
      "type": "lucide",
      "value": "newspaper"
    }
  },
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  }
}
